{
  "name": "composebastion",
  "version": "1.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Multi-host Docker management console deployed with Docker Compose.",
  "repository": {
    "type": "git",
    "url": "https://github.com/composebastion-admin/composebastion.git"
  },
  "bugs": {
    "url": "https://github.com/composebastion-admin/composebastion/issues"
  },
  "homepage": "https://github.com/composebastion-admin/composebastion#readme",
  "workspaces": [
    "apps/api",
    "apps/agent",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspace @composebastion/shared && npm run build --workspace @composebastion/api && npm run build --workspace @composebastion/agent && npm run build --workspace @composebastion/web",
    "dev": "concurrently -n shared,api,web -c cyan,green,magenta \"npm run dev --workspace @composebastion/shared\" \"npm run dev --workspace @composebastion/api\" \"npm run dev --workspace @composebastion/web\"",
    "lint:migrations": "npm run lint:migrations --workspace @composebastion/api",
    "openapi:check": "npm run openapi:check --workspace @composebastion/api",
    "notices:write": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "check:compose-env": "node scripts/check-compose-env.mjs",
    "check:postgres-upgrade": "node scripts/check-postgres-upgrade.mjs",
    "check:actions-pinned": "node scripts/check-actions-pinned.mjs",
    "check:release-workflows": "node scripts/check-release-workflows.mjs",
    "check:npm-install-policy": "node scripts/check-npm-install-policy.mjs",
    "check:npm-version": "node scripts/bootstrap-npm.mjs --check",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check:gitleaks": "bash scripts/check-gitleaks.sh",
    "check:go-attribution": "node scripts/go-attribution.mjs check --manifest LICENSES/go-modules/manifest.json",
    "test:go-attribution-policy": "node --test scripts/go-attribution.test.mjs",
    "test:container-config-policy": "node --test scripts/container-config-policy.test.mjs",
    "test:release-image-policy": "node --test scripts/oci-rootfs.test.mjs",
    "test:release-alias-policy": "bash scripts/reconcile-image-alias-pair.test.sh",
    "test:acceptance-policy": "node --test scripts/acceptance/qualification-policy.test.mjs scripts/acceptance/assert-report.test.mjs scripts/acceptance/candidate-healthcheck.test.mjs scripts/acceptance/manager-environment.test.mjs scripts/acceptance/self-update-outcome.test.mjs",
    "test:upgrade-preparation": "node --test scripts/upgrade-preparation.test.mjs",
    "test:source-upgrade": "node --test scripts/upgrade-source.test.mjs",
    "test:image-upgrade": "node --test scripts/upgrade-image.test.mjs",
    "check:docker-context": "node scripts/check-docker-context.mjs",
    "check:container-config": "node scripts/check-container-config.mjs",
    "release:set-version": "node scripts/set-release-version.mjs",
    "release:verify-images": "node scripts/verify-release-images.mjs",
    "acceptance:local": "node scripts/acceptance/run.mjs",
    "acceptance:config": "node scripts/acceptance/check-config.mjs",
    "acceptance:assert-report": "node scripts/acceptance/assert-report.mjs",
    "upgrade:source": "node scripts/upgrade-source.mjs",
    "upgrade:image": "sh scripts/upgrade-image.sh",
    "smoke:web": "npm run build --workspace @composebastion/shared && npm run smoke --workspace @composebastion/web",
    "smoke:web:qualification": "npm run build --workspace @composebastion/shared && npm run smoke:qualification --workspace @composebastion/web",
    "smoke:web:live": "npm run smoke:live --workspace @composebastion/web",
    "smoke:web:live:qualification": "npm run smoke:live:qualification --workspace @composebastion/web",
    "test": "npm run build --workspace @composebastion/shared && npm run test --workspaces --if-present",
    "coverage": "npm run build --workspace @composebastion/shared && npm run test:coverage --workspace @composebastion/api && npm run test:coverage --workspace @composebastion/agent && npm run test:coverage --workspace @composebastion/web && npm run test:coverage --workspace @composebastion/shared",
    "typecheck": "npm run build --workspace @composebastion/shared && npm run typecheck --workspace @composebastion/api && npm run typecheck --workspace @composebastion/agent && npm run typecheck --workspace @composebastion/web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "spdx-expression-parse": "5.0.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "ssh2@1.17.0": true
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.19.0 <12"
  }
}
